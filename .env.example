# ─── Public ─────────────────────────────────────────────────────────
# Use a full URL with scheme, e.g. https://founderstreet.in or http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ─── Database (Vercel Postgres / Neon) ───────────────────────────────
# In Vercel: Storage → Postgres → Connect Project → injects DATABASE_URL (or POSTGRES_URL)
DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require

# ─── Admin CMS ───────────────────────────────────────────────────────
# Required in production: strong password for /admin/login
ADMIN_PASSWORD=

# Recommended: separate secret for JWT signing (32+ random chars).
# If omitted, ADMIN_PASSWORD is used to sign the session cookie.
ADMIN_JWT_SECRET=

# ─── Vercel Blob (cover images & uploads via POST /api/admin/upload) ─
BLOB_READ_WRITE_TOKEN=

# ─── Optional: AI chat ───────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Email (Resend) — required for SWOT quiz report emails ───────────
# Sign up free at https://resend.com → API Keys → Create key
# Also verify your sending domain (founderstreet.in) in Resend dashboard
RESEND_API_KEY=
